# Used by docker-compose.yml. Copy to web/.env and fill in. Never commit the real .env.
# Generate a strong password, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# The https URL users open, and its host name.
HIRELOG_PUBLIC_ORIGIN=https://hirelog.example.com
HIRELOG_ALLOWED_HOSTS=["hirelog.example.com"]

# Set to false after creating your account.
HIRELOG_ALLOW_REGISTRATION=true
# HIRELOG_MAX_UPLOAD_MB=25
# HIRELOG_SESSION_IDLE_HOURS=12
# HIRELOG_SESSION_ABSOLUTE_DAYS=7

# Optional Google sign-in (redirect URI: <PUBLIC_ORIGIN>/api/auth/google/callback)
HIRELOG_GOOGLE_CLIENT_ID=
HIRELOG_GOOGLE_CLIENT_SECRET=

# Android beta APK. Default: put the signed release APK at backend/data/downloads/hirelog.apk (Docker: /data/downloads/hirelog.apk).
# HIRELOG_ANDROID_VERSION=1.0.0
# HIRELOG_ANDROID_MIN_VERSION=Android 8.0 or later
# true when the APK signs in to this server (same account and data as the web app)
# HIRELOG_ANDROID_SHARED_ACCOUNT=false
# Or host it elsewhere (GitHub Releases, Cloudflare R2...): https URL plus its SHA-256 so users can verify it.
# HIRELOG_ANDROID_APK_URL=
# HIRELOG_ANDROID_APK_SHA256=
