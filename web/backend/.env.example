# Copy to backend/.env and adjust. Never commit the real .env.

# development | production
HIRELOG_ENV=development

# Default is a local SQLite file at backend/data/hirelog.db.
# For Postgres (recommended once several people use it):
# HIRELOG_DATABASE_URL=postgresql+asyncpg://hirelog:<password>@localhost:5432/hirelog

# Where attachments are stored on disk (kept outside any web root).
# HIRELOG_STORAGE_DIR=./data/uploads
# HIRELOG_MAX_UPLOAD_MB=25

# The URL you open in the browser. Dev (Vite): http://localhost:5173. Built app served by the API: http://localhost:8000
HIRELOG_PUBLIC_ORIGIN=http://localhost:5173
# HIRELOG_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Cookies are Secure by default in production. Only set false if you really serve production over plain http.
# HIRELOG_COOKIE_SECURE=true
# HIRELOG_SESSION_IDLE_HOURS=12
# HIRELOG_SESSION_ABSOLUTE_DAYS=7

# Set to false after creating your account to stop anyone else from signing up.
HIRELOG_ALLOW_REGISTRATION=true

# Optional Google sign-in. Create an OAuth "Web application" client in Google Cloud Console and add the
# authorized redirect URI: <PUBLIC_ORIGIN>/api/auth/google/callback
HIRELOG_GOOGLE_CLIENT_ID=
HIRELOG_GOOGLE_CLIENT_SECRET=

# Android beta APK. Default: put the signed release APK at backend/data/downloads/hirelog.apk (Docker: /data/downloads/hirelog.apk).
# HIRELOG_ANDROID_VERSION=1.0.0
# HIRELOG_ANDROID_MIN_VERSION=Android 8.0 or later
# true when the APK signs in to this server (same account and data as the web app)
# HIRELOG_ANDROID_SHARED_ACCOUNT=false
# Or host it elsewhere (GitHub Releases, Cloudflare R2...): https URL plus its SHA-256 so users can verify it.
# HIRELOG_ANDROID_APK_URL=
# HIRELOG_ANDROID_APK_SHA256=
